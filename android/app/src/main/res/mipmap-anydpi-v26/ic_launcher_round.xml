<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (Android 8.0+). The launcher applies its own mask
     to the background layer, so the mark lives in the foreground inside the
     66dp safe circle. The monochrome layer is what Android 13+ tints for
     themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
